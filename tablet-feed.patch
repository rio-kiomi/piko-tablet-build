@@ -0,0 +1,58 @@
+package dev.piko.ui.adaptive
+
+import androidx.compose.ui.unit.dp
+import kotlin.test.Test
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+class FeedLayoutTest {
+    @Test
+    fun `landscape tablet can browse files beside the feed`() {
+        assertTrue(feedPanelFits(false, 1280.dp, 800.dp, 1184.dp, 360.dp))
+    }
+
+    @Test
+    fun `portrait and square mobile windows keep the full screen feed`() {
+        assertFalse(feedPanelFits(false, 1000.dp, 1280.dp, 904.dp, 360.dp))
+        assertFalse(feedPanelFits(false, 1000.dp, 1000.dp, 904.dp, 360.dp))
+    }
+
+    @Test
+    fun `short landscape phone keeps the full screen feed`() {
+        assertFalse(feedPanelFits(false, 1000.dp, 479.dp, 904.dp, 360.dp))
+        assertTrue(feedPanelFits(false, 1000.dp, 480.dp, 904.dp, 360.dp))
+    }
+
+    @Test
+    fun `split screen uses measured content width after navigation`() {
+        assertFalse(feedPanelFits(false, 960.dp, 600.dp, 839.dp, 360.dp))
+        assertTrue(feedPanelFits(false, 960.dp, 600.dp, 840.dp, 360.dp))
+    }
+
+    @Test
+    fun `unmeasured content never opens a side panel`() {
+        assertFalse(feedPanelFits(false, 1280.dp, 800.dp, null, 360.dp))
+        assertFalse(feedPanelFits(true, 1280.dp, 800.dp, null, 360.dp))
+    }
+
+    @Test
+    fun `explicit mobile landscape player remains full screen`() {
+        assertFalse(feedPanelFits(false, 1280.dp, 800.dp, 1184.dp, 360.dp, landscapeLocked = true))
+        assertTrue(feedPanelFits(false, 1280.dp, 800.dp, 1184.dp, 360.dp, landscapeLocked = false))
+    }
+
+    @Test
+    fun `desktop still docks in portrait or short windows when space permits`() {
+        assertTrue(feedPanelFits(true, 1000.dp, 1280.dp, 904.dp, 360.dp))
+        assertTrue(feedPanelFits(true, 1000.dp, 400.dp, 904.dp, 360.dp))
+        assertFalse(feedPanelFits(true, 960.dp, 600.dp, 839.dp, 360.dp))
+    }
+
+    @Test
+    fun `folding and rotating change presentation without changing platform`() {
+        assertTrue(feedPanelFits(false, 1200.dp, 800.dp, 1104.dp, 360.dp))
+        assertFalse(feedPanelFits(false, 800.dp, 1200.dp, 704.dp, 360.dp))
+        assertFalse(feedPanelFits(false, 600.dp, 800.dp, 504.dp, 360.dp))
+        assertTrue(feedPanelFits(false, 1200.dp, 800.dp, 1104.dp, 360.dp))
+    }
+}
