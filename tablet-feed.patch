+package dev.piko.ui.adaptive
+
+import androidx.compose.ui.unit.Dp
+import androidx.compose.ui.unit.dp
+import dev.piko.ui.components.sidePanelFits
+
+/** 只决定信息流的位置，平板仍使用移动端的导航、触屏操作与任务面板。 */
+internal fun feedPanelFits(
+    desktop: Boolean,
+    windowWidth: Dp,
+    windowHeight: Dp,
+    contentWidth: Dp?,
+    panelMinWidth: Dp,
+    landscapeLocked: Boolean = false,
+): Boolean {
+    if (contentWidth == null || !sidePanelFits(contentWidth, panelMinWidth)) return false
+    // 手动进入横屏的全屏信息流保持全屏，避免停靠时释放方向锁又触发一次布局切换。
+    return desktop || (!landscapeLocked && windowWidth > windowHeight && windowHeight >= 480.dp)
+}
